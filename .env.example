# Copy to .env and fill in. .env is gitignored.

# Phase 3 — script and scene-plan generation
ANTHROPIC_API_KEY=

# Voice — Gemini TTS (free tier). Get a key at https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Phase 3 — only if a channel uses voice.provider: elevenlabs
ELEVENLABS_API_KEY=

# Phase 5 — OAuth client downloaded from Google Cloud (Desktop app type)
GOOGLE_OAUTH_CLIENT_FILE=secrets/google-oauth-client.json

# Rendering — empty = Remotion's headless Chrome (falls back to Google Chrome if it crashes).
# "chrome" = always use the installed Google Chrome. A path = that Chrome binary.
YT_BROWSER=
